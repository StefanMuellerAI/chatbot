# ── Pflicht ─────────────────────────────────────────────────────────────
# Passwort für Teilnehmende (lässt sich im Admin-Bereich pro Schulung ändern)
APP_PASSWORD=
# Passwort für den Admin-Bereich (/admin)
ADMIN_PASSWORD=
# Zufälliger Wert mit mind. 32 Zeichen zum Signieren der Sitzungs-Cookies
SESSION_SECRET=

# ── API-Schlüssel ───────────────────────────────────────────────────────
# Claude-Modelle
ANTHROPIC_API_KEY=
# GPT-Modelle, Bildgenerierung, Transkription und Spracheingabe
OPENAI_API_KEY=

# ── Vercel-Speicher (werden beim Verbinden automatisch gesetzt) ─────────
# Neon Postgres (Vercel Marketplace). Ohne: eingebettete Datenbank (nur lokal sinnvoll)
DATABASE_URL=
# Vercel Blob (privater Store). Ohne: lokaler Dateispeicher unter ./.data/files
BLOB_READ_WRITE_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────
# Schützt den täglichen Aufräumjob (/api/cron/cleanup), von Vercel Cron automatisch mitgeschickt
CRON_SECRET=
# Testmodus ohne API-Kosten: Antworten kommen vom Mock-Provider
# FREEBIE_MOCK=1
# Eigener Pfad zu ffmpeg (Standard: ffmpeg-static)
# FFMPEG_PATH=
